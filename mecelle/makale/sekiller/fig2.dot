digraph G {
  graph [fontname="Helvetica", fontsize=11, nodesep=0.45, ranksep=0.55];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded", width=0.6, height=0.32];
  edge [fontname="Helvetica", fontsize=9];
  a5 [label="Art. 5"]; a4 [label="Art. 4"]; a5 -> a4 [label=" + K1"];
  a21 [label="Art. 21"]; a22 [label="Art. 22"]; a21t [label="Art. 21′ (restricted)"];
  a21 -> a21t [label=" entails"]; a22 -> a21 [dir=both, style=dashed, arrowhead=tee, arrowtail=tee, label=" conflict (B4)"];
